<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use platform-specific APIs, use conditional compilation.
        See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
        <TargetFramework>net10.0</TargetFramework>
        <Version>1.0.4</Version>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PublishAot>true</PublishAot>
        <LightDlStaticQuic Condition="'$(LightDlStaticQuic)' == '' and '$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x86'">true</LightDlStaticQuic>
        <AppleMinOSVersion Condition="'$(LightDlStaticQuic)' == 'true' and $(RuntimeIdentifier.StartsWith('osx'))">14.0</AppleMinOSVersion>
        <PublishTrimmed>true</PublishTrimmed>
        <PublishSingleFile>true</PublishSingleFile>
        <TrimMode>full</TrimMode>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>../LightDl.UI/Assets/lightdl-light.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" PrivateAssets="All" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" PrivateAssets="All" Publish="True" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="HotAvalonia" PrivateAssets="All" Publish="True" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="SukiUI" />
        <PackageReference Include="StaticLink.Avalonia" />
        <PackageReference Include="StaticLink.Avalonia.Native" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LightDl.UI\LightDl.UI.csproj" />
        <Content Include="../LightDl.UI/Assets/lightdl-light.png" Link="lightdl.png" Condition="$(RuntimeIdentifier.StartsWith('linux'))"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Import Project="../eng/WindowsX86Brotli.targets" />
</Project>
